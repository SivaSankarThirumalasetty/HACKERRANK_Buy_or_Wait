ts = Counter(r[col] for r in rows)\\n    dups = {k: v for k, v in counts.items() if v > 1}\\n    if dups:\\n        flag(\\\"CRITICAL\\\", f\\\"{name}.{col}: {len(dups)} duplicate values: {list(dups.items())[:5]}\\\")\\n    return dups\\n\\n\\n# ─────────────────────────────────────────────\\n# Load all tables\\n# ───────\n<truncated 19415 bytes>","Description":"\"Data validation script for all CSV files\"","Overwrite":"false","TargetFile":"\"d:\\\\HACKATHON\\\\hackerrank-orchestrate-september26-main\\\\code\\\\validation\\\\data_audit.py\"","toolAction":"\"Writing validation script\"","toolSummary":"\"Data validation script\""}}],"truncated_fields":["tool_calls"]}
